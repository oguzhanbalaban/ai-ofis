# ============================================================================
# Creative Studio — ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyalayın:  copy .env.example .env
# .env asla git'e eklenmez (bkz. .gitignore). Gerçek anahtarları yalnızca .env'e yazın.
# ============================================================================

# --- Çalışma modu -----------------------------------------------------------
# true  : LLM ve YouTube API'leri çağrılmaz; hazır hikaye şablonları kullanılır. Çizim ve ses
#         yerel motorlarla (ekran kartı: FLUX.2 klein + Chatterbox) ya da yedekleriyle yapılır.
#         Ücretli görsel/ses API'leri yalnızca panelde açıkça seçilirse çağrılır.
#         Video yine gerçek FFmpeg ile render edilir.
# false : Senarist/QA/SEO için LLM API'si de kullanılır (ücretlidir!).
MOCK_MODE=true

# Mock modda animasyonların izlenebilmesi için adım içi bekleme çarpanı (0 = beklemesiz)
MOCK_STEP_DELAY=1.5

# --- Ses motoru (Audio & Voice ajanı) -----------------------------------------
# Paneldeki "Ses motoru" seçiminin varsayılanı. Her üretimde panelden değiştirilebilir.
#   auto       : kurulu olan ilk motor: chatterbox > piper > babble
#   chatterbox : Chatterbox Multilingual, ekran kartında, ücretsiz, MIT (ticari serbest), duygulu anlatım.
#                Kurulum: yerel-modeller.ps1. Whisper her cümleyi dinler, kötü okunanı yeniden okutur.
#   piper      : çevrimdışı, ücretsiz ama robotik Türkçe ses. MOCK_MODE'da da çalışır.
#   elevenlabs : en doğal ses, ücretli API (aşağıdaki ELEVENLABS_* alanları). Yalnızca seçildiğinde çağrılır.
#   babble     : anlamsız test mırıltısı · silence : sessizlik
TTS_PROVIDER=auto
# Chatterbox ayarları: duygu yoğunluğu (0.25-1.0; masal için 0.5-0.7), cfg (düşük = daha yavaş/sakin)
CHATTERBOX_EXAGGERATION=0.55
CHATTERBOX_CFG_WEIGHT=0.5
CHATTERBOX_TEMPERATURE=0.8
# İsteğe bağlı anlatıcı ses örneği: 10-20 sn, tek kişi, temiz Türkçe kayıt (hakkı size ait olmalı).
# Dosya yoksa modelin kendi sesi kullanılır.
# CHATTERBOX_REFERENCE=assets/voices/anlatici.wav
# Piper ses modeli ve klasörü (indirme: backend\.venv\Scripts\python scripts\piper_ses_indir.py)
# UYARI: tr_TR-dfki-medium, CC BY-NC-SA 4.0 (TİCARİ OLMAYAN) veriyle eğitilmiştir.
PIPER_VOICE=tr_TR-dfki-medium
# PIPER_MODEL_DIR=backend/models/piper
# Konuşma hızı: 1.0 normal, büyüdükçe yavaşlar (çocuklar için 1.1-1.2 önerilir)
PIPER_LENGTH_SCALE=1.12
# Piper modeli yoksa kullanılacak test sesi: babble | silence
MOCK_VOICE=babble

# --- Sunucu -----------------------------------------------------------------
# Not: 8765-8774 aralığı AI Ekip paneline ayrılmıştır; kullanmayın.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Çıktı klasörleri (göreli yollar proje köküne göredir)
# DATA_DIR=backend/data
# Gerçek modda arka plan müziği için KENDİ telifsiz dosyalarınızı koyacağınız klasör (.mp3/.wav/.ogg/.m4a/.flac)
MUSIC_DIR=assets/music

# --- LLM: Senarist / Görsel Yönetmen / QA / SEO -------------------------------
# anthropic | openai
LLM_PROVIDER=anthropic
# Boş bırakılırsa: anthropic -> claude-sonnet-5-5 ; openai -> gpt-4o-mini
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Görsel üretim (Visual Generator) -----------------------------------------
# Paneldeki "Çizim motoru" seçiminin varsayılanı. Her üretimde panelden değiştirilebilir.
#   auto        : yerel FLUX kuruluysa o, değilse yer tutucu
#   flux_local  : FLUX.2 [klein] 4B, ekran kartında, ücretsiz, Apache 2.0 (kurulum: yerel-modeller.ps1)
#   fal         : fal.ai FLUX API (FAL_KEY)            ~0,004 $/görsel
#   openai      : OpenAI gpt-image-1 (OPENAI_API_KEY)  ~0,063 $/görsel (medium)
#   placeholder : kodla çizilmiş test görseli
IMAGE_PROVIDER=auto
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high (kalite arttıkça fiyat artar)
OPENAI_IMAGE_QUALITY=medium
# Yerel FLUX: adım sayısı (klein için 4), çözünürlük (16'nın katı; sonra 1080x1920'ye kırpılır)
FLUX_STEPS=4
FLUX_WIDTH=1088
FLUX_HEIGHT=1920
# Önce kahramanın referans görselini çizip her sahnede onu kullan (karakter tutarlılığı)
FLUX_REFERENCE=true

# --- ElevenLabs (TTS_PROVIDER=elevenlabs ya da panelde seçildiğinde) ----------------
# Anahtar: elevenlabs.io → Profile → API Keys. Ses kimliği: Voices → bir ses → "Copy voice ID".
# Türkçe için eleven_multilingual_v2 modelini ve sıcak/masalsı bir ses seçin.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Kelime zaman damgaları: elevenlabs (with-timestamps hizalaması) | whisper (OpenAI Whisper, OPENAI_API_KEY gerekir)
TIMESTAMP_PROVIDER=elevenlabs
# Arka plan müziği ses seviyesi (0.0 - 1.0); konuşma sırasında otomatik kısılır (ducking)
MUSIC_VOLUME=0.22

# --- Kurgu (Editor) ---------------------------------------------------------------
RENDER_FPS=60
# ultrafast | superfast | veryfast | faster | fast | medium (yavaşladıkça dosya küçülür)
RENDER_PRESET=veryfast
RENDER_CRF=20
SUBTITLE_FONT=Comic Sans MS
# Sistemde FFmpeg yoksa pip ile gelen imageio-ffmpeg ikilisi kullanılır. Elle yol vermek için:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# --- YouTube yayını (Publisher) ------------------------------------------------------
# GÜVENLİK: Publisher kendiliğinden ASLA yükleme yapmaz; yalnızca taslak üretir.
# Gerçek yükleme için ÜÇ koşul birlikte gerekir:
#   1) MOCK_MODE=false
#   2) YOUTUBE_UPLOAD_ENABLED=true
#   3) Paneldeki önizleme çekmecesinde kutuyu işaretleyip "Onayla ve YouTube'a yükle"ye basmanız
YOUTUBE_UPLOAD_ENABLED=false
# private | unlisted | public  (varsayılan ve önerilen: private)
YOUTUBE_PRIVACY_STATUS=private
# 1 = Film & Animation, 24 = Entertainment, 27 = Education
YOUTUBE_CATEGORY_ID=1
YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# --- Akış denetimi ---------------------------------------------------------------------
MAX_STEP_RETRIES=2
MAX_QA_ROUNDS=2

# --- Ajanlarla sohbet (paneldeki ajan penceresi) ---------------------------------------
# auto   : bilgisayarda Claude Code varsa o, yoksa (yalnızca MOCK_MODE=false iken) LLM API'si, yoksa yerel
# claude : Claude Code (abonelik; API anahtarı kullanılmaz). Araçsız ve salt okunur çalışır.
# llm    : yukarıdaki LLM_PROVIDER / anahtar (ücretli) — yalnızca MOCK_MODE=false iken
# yerel  : yapay zekâsız, paneldeki verilerden kısa yanıt; hiçbir dış çağrı yok
SOHBET_MOTORU=auto
SOHBET_MODEL=sonnet
SOHBET_GUNLUK_SINIR=60
SOHBET_ZAMAN_ASIMI_SN=180
# Claude yolu (boşsa PATH ve %USERPROFILE%\.local\bin\claude.exe aranır)
# CLAUDE_EXE=
# Claude kullanım kartı: 3 saatten yeniyse ve kalan hak bu yüzdenin altındaysa Claude çağrılmaz (hakkın korunur)
# CLAUDE_KULLANIM_DOSYASI=%USERPROFILE%\ai-devir\claude_kullanim.json
SOHBET_MIN_KALAN_YUZDE=30

# --- Bildirimler -------------------------------------------------------------------------
# Masaüstü (Windows) bildirimi: video onay bekliyor, üretim takıldı, günlük özet. Yereldir.
BILDIRIM_MASAUSTU=true
# Telefon: kapali (varsayılan) | ntfy | ai-ekip
#   ntfy    : BILDIRIM_NTFY_KONU'ya gönderir (ntfy uygulamasında aynı konuya abone ol). Başlık ve kısa metin ntfy sunucusuna gider.
#   ai-ekip : AI Ekip ofisinin ayarlar.json > bildirim.telefon kanalını paylaşır (başlık "Studio · ")
BILDIRIM_TELEFON=kapali
BILDIRIM_NTFY_SUNUCU=https://ntfy.sh
BILDIRIM_NTFY_KONU=
# Aynı konu bu kadar dakika içinde bir kez bildirilir; bildirime tıklayınca açılan adres
BILDIRIM_ARALIK_DK=60
BILDIRIM_PANEL_ADRESI=http://127.0.0.1:5173/
# Günlük özet saatleri (data/raporlar/ozet-<tarih>.md + bildirim); "kapali" = otomatik özet yok
OZET_SAATLERI=12:30,18:30

# --- Tahmini maliyet tablosu (USD, kendi planınıza göre güncelleyin) -------------------------
PRICE_LLM_PER_1K_TOKENS=0.006
PRICE_IMAGE_EACH=0.003
PRICE_TTS_PER_1K_CHARS=0.30
PRICE_WHISPER_PER_MIN=0.006
